{
  "name": "pi-durable-swarm",
  "version": "0.4.1",
  "description": "Durable Pi multi-agent swarm for Muse Code: exact MiMo/MiniMax/Z.AI model pins, bounded 6-worker concurrency, retained worktrees, recovery after host restart. Built on @earendil-works/pi-durable.",
  "type": "module",
  "license": "MIT",
  "author": "Alexey Zhokhov",
  "keywords": [
    "pi-package",
    "subagents",
    "swarm",
    "durable",
    "multi-agent"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./src/extension.ts"
    ]
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --experimental-strip-types --test --test-concurrency=1 --test-timeout=60000 test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@earendil-works/chord": "1.0.0",
    "@earendil-works/pi-durable": "1.0.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.0.0",
    "@earendil-works/pi-coding-agent": "1.0.0",
    "@types/node": "26.0.0",
    "typebox": "1.3.27",
    "typescript": "6.0.2"
  }
}
